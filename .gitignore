/workspace/
/research/
/wiki/
*.bundle

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Machine-local agent index — derived data, never part of a delivery
.ragraf/

# Test leftovers
.pytest_cache/
.mypy_cache/
.ruff_cache/
probe-app-*/
.e2e/
.scratch/
